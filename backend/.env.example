# ==============================================================================
# Smart Library Management System - Backend Environment Configuration Example
# Copy this file to '.env' and adjust values for your local or production setup.
# ==============================================================================

# Application Metadata
APP_NAME=Smart Library Management System
APP_ENV=development
DEBUG=False

# Database Connection (MySQL)
# You can either specify individual connection parameters:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=smart_library

# Or provide a full SQLAlchemy connection URL (takes precedence if set):
# DATABASE_URL=mysql+pymysql://root:your_secure_db_password@localhost:3306/smart_library

# Security & JWT Authentication
# Run `openssl rand -hex 32` or python secrets.token_hex(32) to generate a production secret
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Circulation & Library Rules
LOAN_PERIOD_DAYS=14
DAILY_OVERDUE_FINE=5.0

# CORS Allowed Origins (Comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:80,http://localhost
